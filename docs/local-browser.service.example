[Unit]
Description=Local Browser Chrome extension relay
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/local-browser
ExecStart=%h/local-browser/.venv/bin/python %h/local-browser/relay.py --config %h/.hermes/local-browser/config.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
