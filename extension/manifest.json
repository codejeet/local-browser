{
  "manifest_version": 3,
  "name": "Local Browser: AI Browser Automation",
  "version": "1.0.0",
  "description": "Let your AI agent use your existing Chrome tabs and logins. Read pages, fill forms and take screenshots through MCP.",
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "minimum_chrome_version": "135",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "userScripts",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Local Browser",
    "default_popup": "popup.html"
  }
}