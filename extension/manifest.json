{
  "manifest_version": 3,
  "name": "Thrembo Local Browser",
  "version": "1.0.0",
  "description": "Connect your local Chrome to Hermes through your authenticated local-browser relay.",
  "minimum_chrome_version": "135",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "userScripts",
    "storage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Thrembo Local Browser",
    "default_popup": "popup.html"
  }
}